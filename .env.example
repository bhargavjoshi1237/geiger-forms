# Supabase — shared Geiger project (see geiger-flow)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection (shared suite DB) for geiger-orm migrations ONLY.
# Server-only, never NEXT_PUBLIC_. See MIGRATION_CONVENTIONS.md.
STRING_URI=

# Transactional email (confirmation emails)
RESEND_API_KEY=
# Sender for all form emails (verified Resend domain), e.g. "Geiger Forms <forms@yourdomain.com>"
FORMS_EMAIL_FROM=

# Absolute app origin for links in emails/webhooks (falls back to the request origin)
NEXT_PUBLIC_APP_URL=

# Suite hub (geiger-dash) origin that owns the login page, e.g. https://geiger.studio (empty = /login on the current origin)
NEXT_PUBLIC_DASH_ORIGIN=

# Payments (Stripe Checkout). Webhook endpoint: <origin>/api/stripe/webhook
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Payments (PayPal, one-off only). PAYPAL_ENV=live takes real money; anything else uses the sandbox.
# Webhook endpoint: <origin>/api/paypal/webhook (events: PAYMENT.CAPTURE.COMPLETED, PAYMENT.CAPTURE.DENIED)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_ENV=

# Cloudflare Turnstile captcha (per-form "captcha" toggle)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# AES-256-GCM key for "sensitive" (ePHI) fields — base64 of 32 random bytes:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
FORMS_ENCRYPTION_KEY=

# HMAC secret for signed/expiring form links and password cookies (defaults to a key derived from the service role)
FORMS_LINK_SECRET=

# Public origin clients reach the MCP server through (default: https://geiger.studio in production, http://localhost:3000 in dev).
# OAuth is Supabase's, on the Supabase vars above; the server also needs SUPABASE_SERVICE_ROLE_KEY for the audit log.
MCP_PUBLIC_ORIGIN=

# Bearer secret for /api/cron/* (retention, reminders, weekly reports — scheduled in vercel.json)
CRON_SECRET=
